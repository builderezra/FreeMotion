diff --git a/index.html b/index.html
index c39a9ed3..e3e67fa1 100644
--- a/index.html
+++ b/index.html
@@ -401,6 +401,8 @@
     </header>
 
     <div id="main">
+      <!-- #1083, his pick B: a SECOND way out of the project on a PC, a glass pill that appears when the mouse is over the stage's top-left corner. The real back button (#btn-back, in the transport row) stays where it is and this clicks it, so groups are left before the project. Hidden on touch and on phones by CSS. -->
+      <button id="btn-back-corner" class="corner-back" type="button" tabindex="-1" aria-label="Back to projects"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4.5l-7.5 7.5 7.5 7.5"/></svg><span>Projects</span></button>
       <section id="stage">
         <div id="canvas-wrap">
           <canvas id="preview"></canvas>
diff --git a/js/app.js b/js/app.js
index 0e2685ac..6e95a723 100644
--- a/js/app.js
+++ b/js/app.js
@@ -6912,6 +6912,16 @@ window.FM = window.FM || {};
       if (FM.home) FM.home.open();
     });
 
+    /* #1083: the corner pill. It shows while the mouse is inside a 180 x 120 zone at the stage's top-left and clicks the real back button, so one ladder (group, then Home) serves both doors. A zone drawn
+       as an element would sit over the canvas and eat clicks; this listens on #main and draws nothing. */
+    (function () {
+      const pill = document.getElementById('btn-back-corner'), main = document.getElementById('main');
+      if (!pill || !main) return;
+      pill.addEventListener('click', () => { const b = document.getElementById('btn-back'); if (b) b.click(); });
+      main.addEventListener('mousemove', (e) => { const r = main.getBoundingClientRect(); pill.classList.toggle('show', e.clientX - r.left < 180 && e.clientY - r.top < 120); });
+      main.addEventListener('mouseleave', () => pill.classList.remove('show'));
+    })();
+
     // top bar
     const fileInput = document.getElementById('file-input');
     document.getElementById('btn-import').addEventListener('click', () => fileInput.click());
diff --git a/styles.css b/styles.css
index 954cc5c3..ae745214 100644
--- a/styles.css
+++ b/styles.css
@@ -11532,3 +11532,17 @@ html[data-pb-cursor="ew"], html[data-pb-cursor="ew"] * { cursor: ew-resize !impo
 .fm-x:active .fm-x-disc { opacity: .7; }
 /* a DELETE ✕ still warns on hover, as its old glyph did */
 .np-del.fm-x:hover .fm-x-disc, .cap-del.fm-x:hover .fm-x-disc, .fxp-del.fm-x:hover .fm-x-disc { fill: #ff6b6b; }
+
+/* ---- #1083: the hidden back pill, top-left of the stage (PC only; his pick B, the glass pill "‹ Projects") ----
+   Invisible and inert at rest, so it can never swallow a click meant for the canvas. js/app.js adds .show while the mouse is inside the corner zone (180 x 120). Mouse devices only. */
+.corner-back { display: none; }
+@media (min-width: 701px) and (hover: hover) and (pointer: fine) {
+  .corner-back { display: inline-flex; align-items: center; gap: 6px; position: absolute; left: 14px; top: 14px; z-index: 40; height: 34px; padding: 0 14px 0 10px; border-radius: 17px;
+    font: 600 13px/1 -apple-system, system-ui, sans-serif; color: rgb(233,244,247); background: rgba(233,244,247,.09); border: 1px solid rgba(233,244,247,.18);
+    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 6px 18px rgba(0,0,0,.35); cursor: pointer;
+    opacity: 0; transform: translateX(-6px); pointer-events: none; transition: opacity .16s ease-out, transform .16s ease-out; }
+  .corner-back svg { width: 16px; height: 16px; flex: none; }
+  .corner-back.show, .corner-back:focus-visible { opacity: 1; transform: none; pointer-events: auto; }
+  body.text-editing .corner-back, body.drawing .corner-back { display: none; }
+}
+@media (prefers-reduced-motion: reduce) { .corner-back { transition: opacity .16s linear; transform: none; } }
