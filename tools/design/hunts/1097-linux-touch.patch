+++ b/tests/_touch_pass.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Run the real-finger tests that a Linux full pass reports NOT RUN HERE, each in a FRESH browser (hunt/1097-linux-touch, H17).
+
+Why a fresh browser per test: on Linux headless Chrome the first Emulation.setTouchEmulationEnabled(false) takes that PAGE's mouse
+for good (measured, Chrome 141: hover/pointer go to none, and setEmulatedMedia, setDeviceMetricsOverride and a reload do not
+bring them back; a NEW page in the same browser has its mouse, so the loss is per page). A finger test therefore gets a page of
+its own and the page is thrown away. tests/_cdp.py runs it with FM_TOUCH_MODE=lead2 (real emulation, phone media state, one
+finger test per page).
+
+    python3 tests/_cdp.py --port 8777 --names > full.json          # the full pass: touch tests report NOT RUN HERE
+    python3 tests/_touch_pass.py --port 8777 --from full.json [--width 380]
+
+Prints one line per test and a total; exit 1 if any is red. The names come from the NOT RUN list's touch reason.
+"""
+import argparse, json, os, subprocess, sys, time, urllib.parse
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REASON = "needs real touch emulation"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--port", type=int, default=8777)
+    ap.add_argument("--width", default="1280")
+    ap.add_argument("--from", dest="src", required=True, help="JSON from a full `_cdp.py --names` run")
+    ap.add_argument("--timeout", default="400")
+    a = ap.parse_args()
+    raw = open(a.src).read()
+    d = json.loads(raw[raw.find("{"):])
+    names = [x["name"] for x in d.get("notRun", []) if x.get("reason", "").startswith(REASON)]
+    env = dict(os.environ, FM_TOUCH_MODE="lead2")
+    ok = red = 0
+    for n in names:
+        url = "http://localhost:%d/tests/run.html?only=%s" % (a.port, urllib.parse.quote(n))
+        t0 = time.time()
+        p = subprocess.run([sys.executable, os.path.join(HERE, "_cdp.py"), "--port", str(a.port), "--width", str(a.width), "--names",
+                            "--timeout", a.timeout, "--url", url], env=env, capture_output=True, text=True)
+        try:
+            r = json.loads(p.stdout[p.stdout.find("{"):])
+        except Exception:
+            r = {"ok": False, "summary": "no result", "failures": [p.stdout[-200:] + p.stderr[-200:]], "ran": []}
+        # exactly one test must have matched, or the substring caught nothing / several
+        good = bool(r.get("ok")) and len(r.get("ran", [])) == 1 and not r.get("notRun")
+        ok, red = ok + good, red + (not good)
+        print("%s %3ds %s%s" % ("pass" if good else "FAIL", time.time() - t0, n[:90], "" if good else " :: " + (r.get("failures") or [r.get("summary", "")])[0][:200]), flush=True)
+    print("finger tests: %d pass, %d red, of %d" % (ok, red, len(names)))
+    return 1 if red else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
